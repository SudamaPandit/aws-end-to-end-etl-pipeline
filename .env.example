TARGET_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/analytics_db
START_DATE=2026-01-01
END_DATE=2027-01-01

# Optional AI operations
BEDROCK_MODEL_ID=your-approved-bedrock-model-id
