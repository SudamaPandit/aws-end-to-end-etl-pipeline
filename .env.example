# AWS
AWS_REGION=us-east-1
S3_BUCKET=your-etl-bucket
S3_RAW_PREFIX=raw/orders
S3_CURATED_PREFIX=curated/orders
GLUE_JOB_NAME=your-glue-job

# PostgreSQL
